{
  "gateway": {
    "mode": "local"
  },
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://host.docker.internal:11434",
        "apiKey": "ollama-local",
        "api": "ollama",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "qwen2.5:7b",
            "name": "qwen2.5:7b",
            "input": ["text"]
          },
          {
            "id": "llama3.1:8b",
            "name": "llama3.1:8b",
            "input": ["text"]
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/qwen2.5:7b"
      }
    }
  },
  "hooks": {
    "enabled": true,
    "token": "hook-token-lab"
  }
}
